# career-ops environment variables
# Copy this to .env and fill in your values

# Gmail SMTP credentials for email digest
# How to get an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification
#   3. Search "App passwords" → create one named "career-ops"
#   4. Paste the 16-char password below (no spaces)
GMAIL_USER=nikhil.kumar707128@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Digest recipient (defaults to GMAIL_USER if not set)
DIGEST_TO=nikhil.kumar707128@gmail.com
