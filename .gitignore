# ============================================================
# SECRETS — never commit
# ============================================================
.env
*.env.local

# ============================================================
# DATA FILES — tracked in personal fork for remote trigger sync
# (pipeline.md + scan-history.tsv must be committed so the
#  remote trigger can read them for dedup and write new entries)
# ============================================================
# data/applications.md   ← tracked (application tracker)
# data/pipeline.md       ← tracked (trigger writes here)
# data/scan-history.tsv  ← tracked (dedup history)

reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# ============================================================
# USER CONFIG — committed in personal fork (customized for Nikhil)
# ============================================================
# config/profile.yml     ← tracked
# portals.yml            ← tracked (India companies + queries)
# modes/_profile.md      ← tracked
.update-dismissed
.update-lock

# ============================================================
# Generated / local
# ============================================================
.resolved-prompt-*
node_modules/
.DS_Store
*.mov
*.mp4
.claude/settings.local.json
.claude/memory/
career-dashboard
